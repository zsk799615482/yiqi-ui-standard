{
  "meta": {
    "name": "OneSeven Design Tokens",
    "version": "1.1.0",
    "brand": "17 RESEARCH INSTITUTE",
    "principle": "Shared brand foundations with product-level density and component decisions"
  },
  "colors": {
    "primary": {
      "100": "#F3ECF7",
      "500": "#9A6ABA",
      "700": "#68447F"
    },
    "success": {
      "100": "#E7F2EC",
      "500": "#327A5B",
      "700": "#21513D"
    },
    "danger": {
      "100": "#F8E8EB",
      "500": "#B94A5A",
      "700": "#7D303B"
    },
    "neutral": {
      "50": "#FAFAFA",
      "100": "#F5F5F5",
      "200": "#E5E5E5",
      "400": "#A3A3A3",
      "700": "#525252",
      "900": "#171717"
    },
    "common": {
      "white": "#FFFFFF",
      "black": "#000000"
    }
  },
  "semanticColors": {
    "text": {
      "primary": "{colors.neutral.900}",
      "secondary": "{colors.neutral.700}",
      "tertiary": "{colors.neutral.400}",
      "inverse": "{colors.common.white}",
      "brand": "{colors.primary.700}",
      "success": "{colors.success.700}",
      "danger": "{colors.danger.700}"
    },
    "background": {
      "page": "{colors.neutral.50}",
      "surface": "{colors.common.white}",
      "subtle": "{colors.neutral.100}",
      "selected": "{colors.primary.100}",
      "success": "{colors.success.100}",
      "danger": "{colors.danger.100}"
    },
    "border": {
      "default": "{colors.neutral.200}",
      "strong": "{colors.neutral.400}",
      "focus": "{colors.primary.700}",
      "focusRing": "rgba(154, 106, 186, 0.15)",
      "success": "{colors.success.500}",
      "danger": "{colors.danger.500}"
    },
    "status": {
      "info": {
        "background": "{colors.primary.100}",
        "foreground": "{colors.primary.700}"
      },
      "warning": {
        "background": "{colors.neutral.100}",
        "foreground": "{colors.neutral.900}",
        "icon": "{colors.primary.700}"
      },
      "success": {
        "background": "{colors.success.100}",
        "foreground": "{colors.success.700}"
      },
      "danger": {
        "background": "{colors.danger.100}",
        "foreground": "{colors.danger.700}"
      }
    }
  },
  "typography": {
    "fontAssets": [
      {
        "family": "Alibaba PuHuiTi",
        "weight": 200,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-35-Thin.woff2"
      },
      {
        "family": "Alibaba PuHuiTi",
        "weight": 400,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-55-Regular.woff2"
      },
      {
        "family": "Alibaba PuHuiTi",
        "weight": 500,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-65-Medium.woff2"
      },
      {
        "family": "Alibaba PuHuiTi",
        "weight": 600,
        "style": "normal",
        "format": "woff2",
        "path": "./assets/fonts/AlibabaPuHuiTi-3-75-SemiBold.woff2"
      }
    ],
    "fontFamily": {
      "sans": [
        "Alibaba PuHuiTi",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "mono": [
        "SF Mono",
        "Consolas",
        "Menlo",
        "Monaco",
        "Courier New",
        "monospace"
      ]
    },
    "fontWeight": {
      "brand": 200,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px"
    },
    "lineHeight": {
      "xs": "16px",
      "sm": "20px",
      "base": "24px",
      "lg": "28px",
      "xl": "28px",
      "2xl": "32px",
      "3xl": "36px",
      "4xl": "40px",
      "5xl": "52px"
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "density": {
    "compact": {
      "controlHeight": "32px",
      "componentPaddingInline": "12px",
      "componentPaddingBlock": "8px",
      "componentGap": "12px",
      "gridGap": "16px"
    },
    "standard": {
      "controlHeight": "40px",
      "componentPaddingInline": "16px",
      "componentPaddingBlock": "12px",
      "componentGap": "16px",
      "gridGap": "24px"
    },
    "spacious": {
      "controlHeight": "48px",
      "componentPaddingInline": "24px",
      "componentPaddingBlock": "16px",
      "componentGap": "24px",
      "gridGap": "32px"
    }
  },
  "borderRadius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.08)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.12)"
  },
  "motion": {
    "duration": {
      "fast": "200ms",
      "base": "300ms",
      "slow": "500ms",
      "slower": "600ms",
      "reduced": "120ms"
    },
    "easing": {
      "outQuick": "cubic-bezier(0.23, 1, 0.32, 1)",
      "outSmooth": "cubic-bezier(0.32, 0.72, 0, 1)",
      "outBounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "inSmooth": "cubic-bezier(0.32, 0, 0.67, 0)",
      "inOut": "cubic-bezier(0.77, 0, 0.175, 1)"
    },
    "spring": {
      "defaultBounce": 0,
      "spatialBounce": 0.1,
      "button": {
        "duration": 0.2,
        "bounce": 0
      },
      "menu": {
        "duration": 0.3,
        "bounce": 0
      },
      "modal": {
        "duration": 0.5,
        "bounce": 0.1
      },
      "drawer": {
        "duration": 0.6,
        "bounce": 0.1
      },
      "page": {
        "duration": 0.5,
        "bounce": 0
      }
    },
    "loading": {
      "spinnerPeriod": "900ms",
      "skeletonPeriod": "1600ms",
      "progressTransition": "300ms"
    }
  },
  "zIndex": {
    "base": 0,
    "dropdown": 1000,
    "sticky": 1100,
    "overlay": 1200,
    "modal": 1300,
    "popover": 1400,
    "toast": 1500
  }
}
